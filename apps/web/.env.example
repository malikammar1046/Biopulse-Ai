# ==============================================================================
# OvaSense Web App - Environment Configuration
# ==============================================================================

# Supabase Project URL (found in Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon Public API Key (safe for frontend use)
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# Backend API URL (Azure Container Apps FQDN + /api)
# In production on Azure, set this to: https://<your-container-app-fqdn>/api
VITE_BACKEND_API_URL=https://biopulse-backend.azurecontainerapps.io/api

