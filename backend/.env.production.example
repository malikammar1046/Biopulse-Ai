# ==============================================================================
# BioPulse AI - Production Environment Configuration for Azure Container Apps
# Repository: MHamzaAhmed-dev/biopulse-ai-risk-assessment
# Branch: ammar-latest-work
# Target: Azure for Students (Container Apps Consumption)
# ==============================================================================
# Resource Sizing & Memory Guidelines:
# - Initial configuration: 1.0 vCPU, 2.0 GiB RAM
# - Replica scaling: --min-replicas 0 --max-replicas 1 (scale-to-zero for low cost)
# - Gunicorn execution: 1 worker, 2 threads (prevents duplicate ML model preloads)
# - Memory upgrade option: If model inference exceeds available RAM, upgrade via:
#   az containerapp update --name biopulse-backend --resource-group <rg> --cpu 2.0 --memory 4.0Gi
#
# Security Notice:
# In Azure Container Apps, inject these variables using Azure Container Apps
# Secrets (`az containerapp secret set`) and Environment Variables (`--env-vars`).
# NEVER commit production secrets, keys, or database passwords to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Django Production Security & Host Configuration
# ------------------------------------------------------------------------------
# High-entropy production cryptographic secret key (at least 50 random characters)
DJANGO_SECRET_KEY=change-this-to-a-secure-random-50-char-secret-in-production

# Must be False in production
DJANGO_DEBUG=False

# Comma-separated list of fully qualified domain names permitted to serve requests
# Example: biopulse-backend.gentlefield-xyz.eastus.azurecontainerapps.io,127.0.0.1
DJANGO_ALLOWED_HOSTS=*.azurecontainerapps.io,localhost,127.0.0.1

# ------------------------------------------------------------------------------
# 2. CORS (Cross-Origin Resource Sharing)
# ------------------------------------------------------------------------------
# Permitted frontend origins that can communicate with the backend.
# Add your Azure Static Web Apps URL (e.g., https://salmon-wave-xyz.azurestaticapps.net)
# and any custom domains.
CORS_ALLOWED_ORIGINS=https://your-app.azurestaticapps.net,http://localhost:5173

# ------------------------------------------------------------------------------
# 3. Supabase Cloud Database & Authentication
# ------------------------------------------------------------------------------
# Supabase project URL
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase public anonymous API key (used for caller verification)
SUPABASE_ANON_KEY=your-supabase-publishable-key

# Supabase Service Role Secret (Backend-only; permits privileged RPC & clinical state writes)
# CRITICAL: Keep as an Azure Container App Secret. NEVER expose to the frontend.
SUPABASE_SECRET_KEY=your-supabase-service-role-secret-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key-here

# Supabase JWT Secret (Optional: for local HS256/RS256 JWT signature verification)
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here

# ------------------------------------------------------------------------------
# 3b. Django ORM & Doctors Database Persistence (Azure Container Apps)
# ------------------------------------------------------------------------------
# In Azure Container Apps (ACA), the local filesystem is EPHEMERAL and resets on
# cold starts (scale-to-zero), container restarts, or revision deployments.
# To persist Django Admin accounts, admin sessions, and doctor record modifications:
#
# Option A (Recommended for Production): Connect Django ORM to persistent PostgreSQL
# Example: postgres://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres
# or Azure Database for PostgreSQL.
# DATABASE_URL=postgresql://user:password@host:5432/dbname
#
# Option B: Mount an Azure Files persistent volume to /app/data and store SQLite there
# DJANGO_DB_PATH=/app/data/db.sqlite3
#
# If neither is set, Django uses ephemeral SQLite at /app/backend/db.sqlite3.
# Migrations run automatically on container startup, so standard seeded doctors (34)
# are always available, but any new doctors created in Django Admin will NOT persist
# across ACA cold-start recreations.

# ------------------------------------------------------------------------------
# 4. Production Persistence Policy & Maintenance
# ------------------------------------------------------------------------------
# By default False: Disallows silent fallback to ephemeral SQLite when Supabase writes fail.
# Ensures the backend raises PersistenceError (HTTP 500) rather than losing user health data.
ALLOW_LOCAL_SQLITE_FALLBACK=False

# Operational maintenance switch: When True, rejects write requests with HTTP 503
BIOPULSE_ASSESSMENT_MAINTENANCE=False

# Background pre-warming (False in production to ensure active model readiness)
DISABLE_INTELLIGENCE_PREWARM=False
DISABLE_SUPABASE_NETWORK=False

# ------------------------------------------------------------------------------
# 5. Machine Learning Models & Inference
# ------------------------------------------------------------------------------
# Model artifacts location inside the container
ML_MODEL_ARTIFACTS_DIR=/app/machine-learning/PCOS-ML/models

# Feature flag for clean 7-feature Male Tier 1 candidate model (default false)
ENABLE_MALE_TIER1_CLEAN_7FEAT=false

# ------------------------------------------------------------------------------
# 6. Cloud LLM Providers (BioPulse AI Companion & Nutrition Planner)
# ------------------------------------------------------------------------------
# Set LLM_PROVIDER to "gemini" for lightweight cloud inference on Azure
LLM_PROVIDER=gemini

# Google Gemini API Key for AI companion chat and personalized lifestyle plans
GEMINI_API_KEY=your-gemini-api-key-here

# Primary and fallback Gemini models
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=30
GEMINI_MAX_OUTPUT_TOKENS=2500

# Automatic Cloud LLM Failover (Groq):
# If Gemini fails due to unsupported geographic location, timeout, rate limit, or provider outage,
# the backend automatically fails over to Groq using GROQ_API_KEY and GROQ_FALLBACK_MODEL.
GROQ_API_KEY=your-groq-api-key-here
GROQ_FALLBACK_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=30

# (Optional) If hosting an Ollama instance:
# OLLAMA_BASE_URL=https://your-ollama-host:11434
# OLLAMA_MODEL=qwen3:1.7b
