# ==============================================================================
# BioPulse AI - Risk Assessment Platform
# Environment Configuration Template (.env.example)
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this template to .env: `cp .env.example .env`
# 2. Populate variable values for your local development environment.
# 3. CRITICAL: Never commit real API keys, secrets, or database credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Backend & Django Settings
# ------------------------------------------------------------------------------
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081,http://127.0.0.1:5173

# ------------------------------------------------------------------------------
# 2. Supabase & Database Configuration
# ------------------------------------------------------------------------------
# PostgreSQL connection string (direct pooling / Django ORM)
DATABASE_URL=

# Supabase API endpoints & keys
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Local SQLite fallback mode (useful for offline/CI environments without live Supabase)
ALLOW_LOCAL_SQLITE_FALLBACK=True

# ------------------------------------------------------------------------------
# 3. Web Dashboard (React + Vite)
# ------------------------------------------------------------------------------
# Note: VITE_ prefix is required for client-side visibility in Vite
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_BACKEND_API_URL=http://127.0.0.1:8000/api

# ------------------------------------------------------------------------------
# 4. Mobile Application (React Native + Expo)
# ------------------------------------------------------------------------------
# Note: EXPO_PUBLIC_ prefix is required for Expo client runtime
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_BACKEND_API_URL=http://127.0.0.1:8000/api

# ------------------------------------------------------------------------------
# 5. Machine Learning, Vision & OCR Pipeline
# ------------------------------------------------------------------------------
# Path to Tesseract binary (if not in standard PATH)
# Windows example: C:\Program Files\Tesseract-OCR\tesseract.exe
# Linux example: /usr/bin/tesseract
TESSERACT_CMD_PATH=

# Directory containing model artifacts
ML_MODEL_ARTIFACTS_DIR=machine-learning/PCOS-ML/models
