# ==============================================================================
# OVASense - Environment Configuration Template (.env.example)
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to .env: `cp .env.example .env`
# 2. Fill in the placeholder values with your development/staging credentials.
# 3. NEVER commit real secrets, passwords, or service-role keys into Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Backend & Django Settings
# ------------------------------------------------------------------------------
DJANGO_SECRET_KEY=your-django-secret-key-placeholder-here-at-least-50-chars
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081,http://127.0.0.1:5173

# ------------------------------------------------------------------------------
# 2. Supabase & Database Configuration
# ------------------------------------------------------------------------------
# Your Supabase Project URL (e.g., https://xyzcompany.supabase.co)
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Public Anon Key (safe for client apps)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-placeholder

# Supabase Service Role Key (SERVER-SIDE ONLY - NEVER EXPOSE TO FRONTEND/MOBILE)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-backend-only

# Direct PostgreSQL Connection URL (optional for Django ORM / direct pooling)
DATABASE_URL=postgresql://postgres.your-project:your-db-password@aws-0-region.pooler.supabase.com:6543/postgres

# ------------------------------------------------------------------------------
# 3. Web Dashboard (Vite) Environment Variables
# ------------------------------------------------------------------------------
# Prefixed with VITE_ to be accessible in client-side React code
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-placeholder
VITE_BACKEND_API_URL=http://127.0.0.1:8000/api

# ------------------------------------------------------------------------------
# 4. Mobile App (Expo) Environment Variables
# ------------------------------------------------------------------------------
# Prefixed with EXPO_PUBLIC_ to be accessible in Expo client code
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-placeholder
EXPO_PUBLIC_BACKEND_API_URL=http://127.0.0.1:8000/api

# ------------------------------------------------------------------------------
# 5. AI/ML & OCR Pipeline Settings
# ------------------------------------------------------------------------------
# Path to Tesseract binary (if not in standard system PATH)
# Windows default example: C:\Program Files\Tesseract-OCR\tesseract.exe
# Linux default example: /usr/bin/tesseract
TESSERACT_CMD_PATH=
ML_MODEL_ARTIFACTS_DIR=machine-learning/PCOS-ML/models
