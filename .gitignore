# ==============================================================================
# BioPulse AI - Risk Assessment Platform
# Git Exclusion & Repository Hygiene Rules
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Secrets & Environment Configurations (CRITICAL)
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
credentials.json
service-account*.json

# ------------------------------------------------------------------------------
# 2. Local Databases & State Engines
# ------------------------------------------------------------------------------
*.sqlite3
*.sqlite3-journal
*.db
*.sqlite
db.sqlite3
test_fallback.sqlite3
test_fallback.sqlite3-journal

# ------------------------------------------------------------------------------
# 3. Python & Virtual Environments
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
env.bak/
venv.bak/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Pytest & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
nosetests.xml
coverage.xml
*.cover
*.py,cover

# ------------------------------------------------------------------------------
# 4. Node.js & Frontend Artifacts
# ------------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Vite / Frontend Build Outputs
apps/web/dist/
apps/web/dist-ssr/
dist/
dist-ssr/

# Reticle & IDE Extensions
.reticle/
.agents/

# ------------------------------------------------------------------------------
# 5. Mobile & Expo Runtime
# ------------------------------------------------------------------------------
.expo/
.expo-shared/
web-build/
*.orig.*

# ------------------------------------------------------------------------------
# 6. Django Media & Runtime Logs
# ------------------------------------------------------------------------------
backend/media/*
!backend/media/.gitkeep
*.log
logs/

# ------------------------------------------------------------------------------
# 7. Operating System & Editor Metadata
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# Editors
.idea/
.vscode/
*.swp
*.swo
*~
*.sublime-workspace
*.sublime-project

# Scratch & Temporary Notes
scratch/
tmp/
temp/
