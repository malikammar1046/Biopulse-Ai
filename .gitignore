# ==============================================================================
# PMOSense Monorepo - .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Secret Credentials (CRITICAL - NEVER COMMIT)
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
*.env
*.pem
*.key
*.cert
*.p12
*.keystore
id_rsa
serviceAccountKey.json
supabase-service-key*

# ------------------------------------------------------------------------------
# 2. Node.js & JavaScript/TypeScript Packages
# ------------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-store/
.turbo/
.npm/

# ------------------------------------------------------------------------------
# 3. Web & Frontend Build Artifacts (React / Vite)
# ------------------------------------------------------------------------------
dist/
build/
out/
.vite/
.next/
.cache/
.parcel-cache/
storybook-static/

# ------------------------------------------------------------------------------
# 4. Mobile & React Native / Expo
# ------------------------------------------------------------------------------
.expo/
.expo-shared/
dist-expo/
web-build/
*.jks
*.p8
*.mobileprovision
*.orig.*

# Android build outputs
apps/mobile/android/app/build/
apps/mobile/android/.gradle/
apps/mobile/android/local.properties

# iOS build outputs
apps/mobile/ios/Pods/
apps/mobile/ios/build/
*.xcworkspace
!apps/mobile/ios/*.xcworkspace/contents.xcworkspacedata

# ------------------------------------------------------------------------------
# 5. Python & Django
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.sqlite3
*.db
local_settings.py
db.sqlite3-journal
media/
staticfiles/

# Python Virtual Environments
venv/
env/
ENV/
.venv/
env.bak/
venv.bak/
pip-log.txt
pip-delete-this-directory.txt

# ------------------------------------------------------------------------------
# 6. AI/ML, Data & Clinical Privacy (HIPAA / Privacy Protection)
# ------------------------------------------------------------------------------
# Raw patient data, clinical records, DICOM, or unstructured scans
data/raw/
data/patient_records/
*.dcm
*.nii
*.nii.gz
*.csv_raw
machine-learning/ml/checkpoints/
machine-learning/ml/runs/
machine-learning/ml/wandb/
machine-learning/ml/mlruns/
*.h5
*.onnx_large
*.pt
*.pth
*.joblib_large

# Jupyter Notebooks checkpoints
.ipynb_checkpoints/
*-checkpoint.ipynb

# ------------------------------------------------------------------------------
# 7. Testing & Coverage
# ------------------------------------------------------------------------------
coverage/
.nyc_output/
.coverage
.coverage.*
htmlcov/
.pytest_cache/
.tox/
.nox/

# ------------------------------------------------------------------------------
# 8. IDEs & Editors
# ------------------------------------------------------------------------------
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# ------------------------------------------------------------------------------
# 9. OS-Generated Files
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# ------------------------------------------------------------------------------
# 10. Logs & Diagnostics
# ------------------------------------------------------------------------------
logs/
*.log

# ------------------------------------------------------------------------------
# 11. Scratch & Agent Diagnostics
# ------------------------------------------------------------------------------
scratch/
.reticle/
**/.reticle/
**/.reticle.json
walkthrough.md
